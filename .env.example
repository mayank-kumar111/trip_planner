# =====================================================
# Trip Planner — environment contract
# =====================================================
# EXECUTIVE: copy to .env.local and fill only values required by your environment.
# SECURITY: never commit real secrets. Documentation uses <INSERT_PRODUCTION_KEY_HERE>.
# Variables prefixed NEXT_PUBLIC_ are intentionally browser-visible, not secrets.

# Persistence — Convex
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# Clerk JWT issuer is configured in the Convex deployment environment:
# npx convex env set CLERK_JWT_ISSUER_DOMAIN "https://YOUR-CLERK-DOMAIN.clerk.accounts.dev"

# Authentication — Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/sign-up

# AI — Google Gemini Developer API
# TECHNICAL: server-side secret; never prefix the key with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Abuse protection — Arcjet
ARCJET_KEY=

# Google Maps Platform — server-side Places API (New)
GOOGLE_PLACE_API_KEY=

# Google Maps Platform — server-side Routes API
GOOGLE_ROUTES_API_KEY=

# Google Maps Platform — browser Maps JavaScript API
# Keep false unless browser map rendering is intentionally enabled and configured.
NEXT_PUBLIC_ENABLE_GOOGLE_MAPS=false
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional Google Cloud map ID for browser map configuration.
NEXT_PUBLIC_GOOGLE_MAP_ID=

# AI subscription / usage limits
# Server-side values enforce quota in /api/aimodel.
FREE_AI_GENERATIONS=5
PAID_AI_GENERATIONS=100
CLERK_PREMIUM_PLAN_SLUG=monthly

# Public display values; not secrets. Keep aligned with server defaults.
NEXT_PUBLIC_FREE_AI_GENERATIONS=5
NEXT_PUBLIC_PAID_AI_GENERATIONS=100
NEXT_PUBLIC_CLERK_PREMIUM_PLAN_SLUG=monthly

# Support/contact — intentionally public if populated
NEXT_PUBLIC_SUPPORT_EMAIL=

# Optional homepage demo video (leave blank to hide the video section)
# Set to a publicly accessible video URL (e.g. a YouTube embed or direct MP4).
NEXT_PUBLIC_DEMO_VIDEO_URL=
NEXT_PUBLIC_DEMO_VIDEO_THUMBNAIL=

# Durable trip processing — server-to-server worker
TRIP_PROCESS_WORKER_URL=http://localhost:3000/api/trip/process-worker
TRIP_WORKER_SECRET=

# Production documentation placeholder example (DO NOT paste a real value here):
# GEMINI_API_KEY=<INSERT_PRODUCTION_KEY_HERE>
